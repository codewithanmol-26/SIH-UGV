# Copy this file to backend/.env and adjust as needed.
# Every variable is prefixed UGV_ and maps directly onto backend/config/settings.py.
# Nothing here is required — the system runs with these defaults out of the box.

# --- Runtime mode ---------------------------------------------------------
# DEVELOPMENT: laptop + webcam/video file, SimulationMotorController (default)
# HARDWARE:    onboard computer + real camera + HardwareMotorController (NOT_IMPLEMENTED)
UGV_RUNTIME_MODE=DEVELOPMENT

# --- Camera ----------------------------------------------------------------
# webcam | video_file | ip_stream | rtsp
UGV_CAMERA_SOURCE=webcam
UGV_CAMERA_DEVICE_INDEX=0
UGV_CAMERA_VIDEO_PATH=../sample_data/sample_outdoor.mp4
UGV_CAMERA_IP_URL=
UGV_CAMERA_RTSP_URL=
UGV_CAMERA_WIDTH=640
UGV_CAMERA_HEIGHT=480

# --- AI perception -----------------------------------------------------
# Nano weights auto-download from the official Ultralytics release on first
# run. Swap to yolo26s.pt (small) if your machine has the FPS headroom.
UGV_YOLO_MODEL_NAME=yolo26n.pt
UGV_YOLO_WEIGHTS_PATH=../models/yolo26n.pt
UGV_YOLO_CONFIDENCE_THRESHOLD=0.45
UGV_YOLO_DEVICE=auto

# --- Traversability ---------------------------------------------------------
# classical (ACTIVE) | segmentation (NOT_IMPLEMENTED)
UGV_TRAVERSABILITY_METHOD=classical

# --- Localization -----------------------------------------------------------
# orb_vo (ACTIVE) | slam3 (NOT_IMPLEMENTED)
UGV_LOCALIZATION_METHOD=orb_vo

# --- Server -------------------------------------------------------------
UGV_HOST=0.0.0.0
UGV_PORT=8000

# --- Optional persistence (spec §18 — off by default, system works without it) ---
UGV_DATABASE_ENABLED=false
