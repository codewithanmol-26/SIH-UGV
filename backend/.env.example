# Copy to backend/.env and adjust. All vars are prefixed UGV_ (see
# backend/config/settings.py — pydantic-settings loads this automatically).

UGV_RUNTIME_MODE=DEVELOPMENT

# --- Camera ---
UGV_CAMERA_SOURCE=webcam
UGV_CAMERA_DEVICE_INDEX=0
UGV_CAMERA_VIDEO_PATH=../sample_data/sample_outdoor.mp4
UGV_CAMERA_WIDTH=640
UGV_CAMERA_HEIGHT=480

# --- AI perception ---
UGV_YOLO_MODEL_NAME=yolo26n.pt
UGV_YOLO_WEIGHTS_PATH=../models/yolo26n.pt
UGV_YOLO_CONFIDENCE_THRESHOLD=0.45
UGV_YOLO_DEVICE=auto

# --- Traversability / localization ---
UGV_TRAVERSABILITY_METHOD=classical
UGV_LOCALIZATION_METHOD=orb_vo

# --- Server ---
UGV_HOST=0.0.0.0
UGV_PORT=8000

# --- Optional persistence (disabled by default, spec §18) ---
UGV_DATABASE_ENABLED=false
